+        // de que el buffer se llene).
+        val pll = AudioTrackBufferPll(48_000)
+        assertEquals(9_000L, pll.estimateOccupancy(9_000, 1_000_000_000L))
+        assertEquals(0L, pll.estimateOccupancy(0, 1_000_000_000L))
+    }
+
+    @Test fun resetLevelIntegralClearsWindupWithoutTouchingClock457() {
+        // El reset del integrador (pacing) solo toca el PI de nivel: la
+        // estima de reloj (deriva medida) sobrevive.
+        val pll = AudioTrackBufferPll(48_000)
+        var consumed = 0L
+        repeat(100) { k ->
+            val t = 1.0 + k * 0.25
+            consumed = (t * 48_000.0 * (1.0 + 8.5e-6)).toLong()
+            pll.observe(consumed + 5_000L, consumed, 10_000, (t * 1.0e9).toLong(), underruns = 0L)
+        }
+        assertTrue("la deriva debe estar medida antes del reset", pll.isDriftLocked)
+        pll.resetLevelIntegral()
+        assertTrue("el reset de nivel no debe borrar la estima de reloj", pll.isDriftLocked)
+        assertEquals(8.5, pll.measuredDriftPpm, 3.0)
+    }
 }
